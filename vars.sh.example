#!/bin/bash
#================================================================
# Copyright © 2026 Mini Civilisation
#
# Settings for cx.sh (the LOCAL assistant). Copy to vars.sh and fill in:
#
#   cp vars.sh.example vars.sh
#
# vars.sh is gitignored — it names hosts and accounts, so it stays out of
# the repo. This example carries placeholders only.
#================================================================

# --- Identity ------------------------------------------------------------
PROJECT="miniciv.example.com"        # project dir under ~/.ssh/remote/ and ~/www/
REMOTE_USER="your-hosting-user"
REMOTE_HOST="your-host.example.net"
REMOTE="$REMOTE_USER@$REMOTE_HOST"
REMOTE_PORT="22"                     # SiteGround uses 18765

# Other sites this script can act on (shown in the menu banner).
SITES=("$PROJECT")

# App root on the server, relative to ~. deploy.sh, .env, artisan and
# public_html/ live here. cx.sh defaults this to www/$PROJECT if unset.
REMOTE_APP="www/$PROJECT"

# What the health options check. Public URL, so the check covers DNS and
# TLS as well as PHP. Defaults to https://$PROJECT.
APP_URL="https://$PROJECT"

# Where remote backups are pulled to locally (option 92).
LOCAL_BACKUPS="$HOME/backups/$PROJECT"

# --- Tooling -------------------------------------------------------------
# Kept as variables so you can add flags once (e.g. -i KEY).
APP_SSH="ssh -p $REMOTE_PORT"
APP_SCP="scp -P $REMOTE_PORT"
APP_RSYNC="rsync -e 'ssh -p $REMOTE_PORT'"

# --- Local paths ---------------------------------------------------------
# Appended to by options that tee remote output.
LOG_OUTPUT="./log/remote.out"
